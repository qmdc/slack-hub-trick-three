<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.slack.slackjarservice.typingtest.dao.TypingTestRecordDao">

    <resultMap type="com.slack.slackjarservice.typingtest.entity.TypingTestRecord" id="TypingTestRecordMap">
        <result property="id" column="id" jdbcType="BIGINT"/>
        <result property="userId" column="user_id" jdbcType="BIGINT"/>
        <result property="articleId" column="article_id" jdbcType="BIGINT"/>
        <result property="articleTitle" column="article_title" jdbcType="VARCHAR"/>
        <result property="wpm" column="wpm" jdbcType="DECIMAL"/>
        <result property="accuracy" column="accuracy" jdbcType="DECIMAL"/>
        <result property="typedText" column="typed_text" jdbcType="LONGVARCHAR"/>
        <result property="correctChars" column="correct_chars" jdbcType="INTEGER"/>
        <result property="totalChars" column="total_chars" jdbcType="INTEGER"/>
        <result property="testDuration" column="test_duration" jdbcType="INTEGER"/>
        <result property="startTime" column="start_time" jdbcType="BIGINT"/>
        <result property="endTime" column="end_time" jdbcType="BIGINT"/>
        <result property="createTime" column="create_time" jdbcType="BIGINT"/>
        <result property="updateTime" column="update_time" jdbcType="BIGINT"/>
        <result property="deleted" column="deleted" jdbcType="INTEGER"/>
        <result property="version" column="version" jdbcType="BIGINT"/>
    </resultMap>

    <select id="selectByUserIdOrderByStartTimeDesc" resultMap="TypingTestRecordMap">
        SELECT * FROM typing_test_record WHERE user_id = #{userId} AND deleted = 0 ORDER BY start_time DESC
    </select>

    <select id="selectByUserIdAndDateRange" resultMap="TypingTestRecordMap">
        SELECT * FROM typing_test_record WHERE user_id = #{userId} AND start_time &gt;= #{startDate} AND start_time &lt;= #{endDate} AND deleted = 0 ORDER BY start_time DESC
    </select>

    <select id="selectMaxWpmByUserId" resultType="java.math.BigDecimal">
        SELECT MAX(wpm) FROM typing_test_record WHERE user_id = #{userId} AND deleted = 0
    </select>

    <select id="selectAvgWpmByUserId" resultType="java.math.BigDecimal">
        SELECT AVG(wpm) FROM typing_test_record WHERE user_id = #{userId} AND deleted = 0
    </select>

    <select id="selectAvgAccuracyByUserId" resultType="java.math.BigDecimal">
        SELECT AVG(accuracy) FROM typing_test_record WHERE user_id = #{userId} AND deleted = 0
    </select>

    <select id="selectTotalCountByUserId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM typing_test_record WHERE user_id = #{userId} AND deleted = 0
    </select>

    <select id="selectWeeklyRecords" resultMap="TypingTestRecordMap">
        SELECT * FROM typing_test_record WHERE user_id = #{userId} AND start_time &gt;= #{startTime} AND deleted = 0 ORDER BY start_time ASC
    </select>

</mapper>