<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.slack.slackjarservice.typingtest.dao.TypingArticleDao">

    <resultMap type="com.slack.slackjarservice.typingtest.entity.TypingArticle" id="TypingArticleMap">
        <result property="id" column="id" jdbcType="BIGINT"/>
        <result property="title" column="title" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="LONGVARCHAR"/>
        <result property="wordCount" column="word_count" jdbcType="INTEGER"/>
        <result property="difficulty" column="difficulty" jdbcType="INTEGER"/>
        <result property="category" column="category" jdbcType="VARCHAR"/>
        <result property="status" column="status" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="BIGINT"/>
        <result property="updateTime" column="update_time" jdbcType="BIGINT"/>
        <result property="deleted" column="deleted" jdbcType="INTEGER"/>
        <result property="version" column="version" jdbcType="BIGINT"/>
    </resultMap>

    <select id="selectEnabledArticles" resultMap="TypingArticleMap">
        SELECT * FROM typing_article WHERE status = 0 AND deleted = 0
    </select>

    <select id="selectByDifficulty" resultMap="TypingArticleMap">
        SELECT * FROM typing_article WHERE difficulty = #{difficulty} AND status = 0 AND deleted = 0
    </select>

    <select id="selectAllCategories" resultType="java.lang.String">
        SELECT DISTINCT category FROM typing_article WHERE status = 0 AND deleted = 0 AND category IS NOT NULL
    </select>

</mapper>